class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
       unordered_map<int, int> map;

       //키 값이 nums의 값, value = nums의 인덱스
       for(int ix = 0; ix<nums.size(); ++ix)
       {
            map[nums[ix]] = ix;
       }

       //value와 맞는 쌍 순회 돌면서 찾기.
       //같은 값일 경우 키 값이 덮어씌워지기 때문에 i=0과 map의 value=1과 비교되어서 return 바로 반환.
       //시간 복잡도는 O(N)
       for(int i = 0; i< nums.size(); ++ i)
       {
            int complement = target - nums[i];
            if(map.count(complement) && map[complement] != i)
            {
                return {i, map[complement]};
            }
       }

       

       return {};
    }
};
