/* 게임 규칙: 덱 하나가 뒤집힌 채 테이블에 있을 때
   맨 앞 한 장은 뒤집어서 보여주고 뒤에 한 장은 맨 뒤로 보냄.
   카드가 2장이상이라면 위 과정을 반복함.
   마지막 한 장이 남았을 때는 그냥 뒤집어서 보여줌.
   ex) Input: deck = [17,13,11,2,3,5,7] -> 이러한 배열의 덱이 있으면
   이 배열을 다시 정렬하여 게임을 진행시켰을 때 오름차순이 되게 해야됨.
   Output: [2,13,3,11,5,17,7]
*/
       

#include <queue>
#include <vector>
#include <algorithm>

using namespace std;

class Solution {
public:
    vector<int> deckRevealedIncreasing(vector<int>& deck) {
        queue<int> q;
        //재정렬한 원소를 담을 배열
        vector<int> result(deck.size());
        //배열 오름차순 정렬
        sort(deck.begin(), deck.end());
        int index = 0;

        for(int ix=0; ix<deck.size(); ++ix)
        {
            q.push(ix);
        }

        while(!q.empty())
        {
             int current = q.front();
             q.pop();

             //재정렬한 인덱스에 맞는 원소 복사
            result[current] = deck[index];
            ++index;

            if(!q.empty())
            {
                //front 팝하고 다음 인덱스 뒤로 넘기기.
                int next = q.front();
                q.pop();
                q.push(next);
            }
             
        }

        return  result;
    }
};

// 큐에 정렬된 인덱스를 게임에 똑같이 적용시켰을 때 오름차순 정렬이 나와야함.
